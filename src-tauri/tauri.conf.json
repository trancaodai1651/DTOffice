{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DT Office",
  "version": "0.4.11",
  "identifier": "com.myoffice.desktop",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "DT Office",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "url": "index.html"
      },
      {
        "label": "codex-bot",
        "title": "Codex Bot",
        "url": "bot.html",
        "width": 176,
        "height": 222,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../.desktop/office/": "office/",
      "../.desktop/node/": "node/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
